{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "description": "Primary build agent for implementation work",
      "mode": "primary",
      "model": "openai/gpt-5.1-codex-mini",
      "temperature": 0.3,
      "prompt": "{file:./prompts/build.md}"
    },
    "plan": {
      "description": "Primary planning agent with delegated exploration",
      "mode": "primary",
      "model": "openai/gpt-5.2-codex",
      "temperature": 0.2,
      "prompt": "{file:./prompts/plan.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "architector": {
      "description": "Planning assistant for clear, ordered steps",
      "mode": "subagent",
      "model": "openai/gpt-5.2-codex",
      "temperature": 0.2,
      "prompt": "{file:./prompts/architector.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "reviewer": {
      "description": "Lightweight code reviewer for correctness and risks",
      "mode": "subagent",
      "model": "openai/gpt-5.2-codex",
      "temperature": 0.2,
      "prompt": "{file:./prompts/reviewer.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "debugger": {
      "description": "Debugging assistant for diagnosing failures",
      "mode": "subagent",
      "model": "openai/gpt-5.2-codex",
      "temperature": 0.2,
      "prompt": "{file:./prompts/debugger.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "implementer": {
      "description": "Implementation assistant for focused code changes",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex-mini",
      "temperature": 0.3,
      "prompt": "{file:./prompts/implementer.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "tester": {
      "description": "Testing assistant for targeted test runs",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex-mini",
      "temperature": 0.3,
      "prompt": "{file:./prompts/tester.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "documenter": {
      "description": "Documentation assistant for concise updates",
      "mode": "subagent",
      "model": "openai/gpt-5.1-codex-mini",
      "temperature": 0.3,
      "prompt": "{file:./prompts/documenter.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false
      }
    }
  }
}
